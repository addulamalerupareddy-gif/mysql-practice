-- 25. final challenge: create a result containing employee name, department, salary, department average salary, department rank, difference from department average and previous employee salary based on joining date.
-- then display only employees who earn more than their department average, have a department rank of 1 or 2, and sort by department and salary descending.
select employee_name,department,salary,department_avg_salary,department_rank,
salary - department_avg_salary as difference_from_department_average,previous_employee_salary
from (select employee_name,department,salary,joining_date,
avg(salary) over(partition by department) as department_avg_salary,
rank() over(partition by department order by salary desc) as department_rank,
lag(salary) over(order by joining_date) as previous_employee_salary
from employees) as e
where salary > department_avg_salary
and department_rank in (1, 2)
order by department, salary desc;

