SELECT AIRLINE,AVG(TICKET_PRICE) AS AVG_TICKET_PRICE
FROM FLIGHTS
WHERE PASSENGER_AGE BETWEEN 20 AND 35
GROUP  BY AIRLINE
HAVING AVG_TICKET_PRICE >12000;

