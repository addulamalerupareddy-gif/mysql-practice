SELECT AIRLINE,COUNT(*) AS TOTAL_CONFIRMED_BOOKINGS
FROM FLIGHTS
WHERE TICKET_PRICE > 5000 AND BOOKING_STATUS='CONFIRMED'
GROUP BY AIRLINE
