select * from attendees;
select * from organizers;
select * from venues;
select * from events;
select * from bookings;
select * from online_ticket_sales;
select * from offline_ticket_sales;

-- 1
SELECT e.* 
FROM events e
JOIN venues v ON e.venue_id = v.venue_id
WHERE v.city = 'Hyderabad';
-- 2
SELECT * 
FROM events 
WHERE ticket_price BETWEEN 1000 AND 5000 
ORDER BY ticket_price DESC;
-- 3
SELECT o.organizer_id, o.organizer_name, COUNT(e.event_id) AS event_count
FROM organizers o
LEFT JOIN events e ON o.organizer_id = e.organizer_id
GROUP BY o.organizer_id, o.organizer_name;
-- 4
SELECT e.event_name, o.organizer_name, v.venue_name
FROM events e
JOIN organizers o ON e.organizer_id = o.organizer_id
JOIN venues v ON e.venue_id = v.venue_id;
-- 5
SELECT v.*
FROM venues v
LEFT JOIN events e ON v.venue_id = e.venue_id
WHERE e.event_id IS NULL;
-- 6
SELECT e.event_id, e.event_name, SUM(b.ticket_count) AS total_tickets
FROM events e
JOIN bookings b ON e.event_id = b.event_id
GROUP BY e.event_id, e.event_name;
-- 7
SELECT e.event_id, e.event_name, SUM(b.ticket_count * e.ticket_price) AS total_revenue
FROM events e
JOIN bookings b ON e.event_id = b.event_id
WHERE b.booking_status = 'Confirmed'
GROUP BY e.event_id, e.event_name
ORDER BY total_revenue DESC
LIMIT 1;
-- 8
SELECT event_name, ticket_price,
       CASE 
           WHEN ticket_price < 2000 THEN 'Budget'
           WHEN ticket_price BETWEEN 2000 AND 5000 THEN 'Standard'
           ELSE 'Premium'
       END AS price_category
FROM events;
-- 9
SELECT v.city, COUNT(e.event_id) AS total_events
FROM venues v
JOIN events e ON v.venue_id = e.venue_id
GROUP BY v.city
HAVING COUNT(e.event_id) > 3;
-- 10
SELECT * 
FROM events 
WHERE event_date >= CURDATE()
ORDER BY event_date ASC
LIMIT 5;
-- 11
SELECT DISTINCT a.*
FROM attendees a
JOIN bookings b ON a.attendee_id = b.attendee_id;
-- 12
SELECT a.*
FROM attendees a
LEFT JOIN bookings b ON a.attendee_id = b.attendee_id
WHERE b.booking_id IS NULL;
-- 13
SELECT a.attendee_id, a.attendee_name, COALESCE(SUM(b.ticket_count * e.ticket_price), 0) AS total_spent
FROM attendees a
JOIN bookings b ON a.attendee_id = b.attendee_id
JOIN events e ON b.event_id = e.event_id
WHERE b.booking_status = 'Confirmed'
GROUP BY a.attendee_id, a.attendee_name;
-- 14
SELECT a.attendee_id, a.attendee_name, SUM(b.ticket_count * e.ticket_price) AS total_spent
FROM attendees a
JOIN bookings b ON a.attendee_id = b.attendee_id
JOIN events e ON b.event_id = e.event_id
WHERE b.booking_status = 'Confirmed'
GROUP BY a.attendee_id, a.attendee_name
HAVING SUM(b.ticket_count * e.ticket_price) > 20000;
-- 15
SELECT o.organizer_id, o.organizer_name, SUM(b.ticket_count * e.ticket_price) AS total_revenue
FROM organizers o
JOIN events e ON o.organizer_id = e.organizer_id
JOIN bookings b ON e.event_id = b.event_id
WHERE b.booking_status = 'Confirmed'
GROUP BY o.organizer_id, o.organizer_name
HAVING SUM(b.ticket_count * e.ticket_price) > 100000;
-- 16
SELECT AVG(ticket_price) AS avg_ticket_price 
FROM events;
-- 17
SELECT * 
FROM events 
WHERE ticket_price > (SELECT AVG(ticket_price) FROM events);
-- 18
SELECT attendee_id, COUNT(booking_id) AS total_bookings
FROM bookings
GROUP BY attendee_id
HAVING COUNT(booking_id) > (
    SELECT COUNT(booking_id) / COUNT(DISTINCT attendee_id) 
    FROM bookings
);
-- 19
SELECT e1.* 
FROM events e1
WHERE e1.ticket_price > (
    SELECT AVG(e2.ticket_price) 
    FROM events e2 
    WHERE e2.category = e1.category
);
-- 20
SELECT * 
FROM events 
WHERE ticket_price > ALL (
    SELECT ticket_price 
    FROM events 
    WHERE category = 'Workshop'
);
-- 21
SELECT * 
FROM events 
WHERE ticket_price < ANY (
    SELECT ticket_price 
    FROM events 
    WHERE category = 'Technology'
);
-- 22
SELECT e1.* 
FROM events e1
WHERE e1.ticket_price > (
    SELECT AVG(e2.ticket_price) 
    FROM events e2 
    WHERE e2.category = e1.category
);
-- 23
SELECT organizer_id, COUNT(event_id) AS event_count
FROM events
GROUP BY organizer_id
HAVING COUNT(event_id) > (
    SELECT COUNT(event_id) / COUNT(DISTINCT organizer_id) 
    FROM events
);
-- 24
SELECT * 
FROM venues 
WHERE capacity > (SELECT AVG(capacity) FROM venues);
-- 25
SELECT DISTINCT a.*
FROM attendees a
JOIN bookings b ON a.attendee_id = b.attendee_id
JOIN events e ON b.event_id = e.event_id
WHERE e.ticket_price > (SELECT AVG(ticket_price) FROM events);
-- 26
SELECT attendee_name, city, event_name, category, ticket_count, amount, sale_date, discount, status 
FROM online_ticket_sales
UNION ALL
SELECT attendee_name, city, event_name, category, ticket_count, amount, sale_date, discount, status 
FROM offline_ticket_sales;
-- 27
SELECT 
    attendee_name, 
    event_name, 
    amount, 
    discount,
    (amount - (amount * discount / 100)) AS net_amount
FROM (
    SELECT attendee_name, event_name, amount, discount FROM online_ticket_sales
    UNION ALL
    SELECT attendee_name, event_name, amount, discount FROM offline_ticket_sales
) AS combined_sales;
-- 28
SELECT 
    event_name, 
    SUM(amount - (amount * discount / 100)) AS total_net_revenue
FROM (
    SELECT event_name, amount, discount FROM online_ticket_sales
    UNION ALL
    SELECT event_name, amount, discount FROM offline_ticket_sales
) AS combined_sales
GROUP BY event_name
ORDER BY total_net_revenue DESC;
-- 29
SELECT 
    category, 
    SUM(ticket_count) AS total_tickets_sold
FROM (
    SELECT category, ticket_count FROM online_ticket_sales
    UNION ALL
    SELECT category, ticket_count FROM offline_ticket_sales
) AS combined_sales
GROUP BY category
ORDER BY total_tickets_sold DESC;
-- 30
SELECT 
    category, 
    SUM(ticket_count) AS total_tickets_sold
FROM (
    SELECT category, ticket_count, status FROM online_ticket_sales
    UNION ALL
    SELECT category, ticket_count, status FROM offline_ticket_sales
) AS combined_sales
WHERE status = 'Confirmed'
GROUP BY category
ORDER BY total_tickets_sold DESC
LIMIT 3;
-- 31
SELECT event_name, LENGTH(event_name) AS character_length
FROM events;
-- 32
SELECT sale_id, sale_date,
       DATE_FORMAT(STR_TO_DATE(sale_date, '%Y-%m-%d'), '%d-%M-%Y') AS formatted_date
FROM (
    SELECT sale_id, sale_date FROM online_ticket_sales
    UNION ALL
    SELECT sale_id, sale_date FROM offline_ticket_sales
) AS all_sales;
-- 33
SELECT 
    category,
    SUM(ticket_count) AS total_tickets,
    SUM(amount - (amount * discount / 100)) AS total_final_revenue
FROM (
    SELECT category, ticket_count, amount, discount FROM online_ticket_sales
    UNION ALL
    SELECT category, ticket_count, amount, discount FROM offline_ticket_sales
) AS combined_sales
GROUP BY category;
-- 34
WITH CategoryRevenue AS (
    SELECT 
        category,
        SUM(amount - (amount * discount / 100)) AS cat_revenue
    FROM (
        SELECT category, amount, discount FROM online_ticket_sales
        UNION ALL
        SELECT category, amount, discount FROM offline_ticket_sales
    ) AS combined_sales
    GROUP BY category
)
SELECT category, cat_revenue
FROM CategoryRevenue
WHERE cat_revenue > (SELECT AVG(cat_revenue) FROM CategoryRevenue);
-- 35
SELECT 
    o.organizer_name,
    SUM(b.ticket_count * e.ticket_price) AS total_booking_revenue
FROM organizers o
JOIN events e ON o.organizer_id = e.organizer_id
JOIN bookings b ON e.event_id = b.event_id
WHERE b.booking_status = 'Confirmed'
  AND e.event_status = 'Completed'
GROUP BY o.organizer_id, o.organizer_name
HAVING 
    COUNT(DISTINCT e.event_id) > (
        SELECT COUNT(event_id) / COUNT(DISTINCT organizer_id) 
        FROM events
    )
    AND SUM(b.ticket_count * e.ticket_price) > 100000
    AND MAX(e.ticket_price) > (
        SELECT AVG(ticket_price) 
        FROM events
    )
ORDER BY total_booking_revenue DESC;
