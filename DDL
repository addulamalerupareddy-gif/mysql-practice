CREATE DATABASE tfi_database;
USE tfi_database;
CREATE TABLE  movies (
    movie_id INT,
    title VARCHAR(100),
    release_date DATE,
    language VARCHAR(30),
    genre VARCHAR(50),
    budget DECIMAL(12,2),
    box_office DECIMAL(12,2),
    rating DECIMAL(3,1)
);
SHOW TABLES;
CREATE TABLE actors (
    actor_id INT,
    actor_name VARCHAR(100),
    date_of_birth DATE,
    debut_year YEAR
);
SHOW TABLES;
CREATE TABLE directors (
    director_id INT,
    director_name VARCHAR(100),
    date_of_birth DATE,
    debut_year YEAR
);
SHOW TABLES;
CREATE TABLE producers (
    producer_id INT,
    producer_name VARCHAR(100),
    production_house VARCHAR(100)
);
SHOW TABLES;
CREATE TABLE genres (
    genre_id INT,
    genre_name VARCHAR(50),
    description VARCHAR(200)
);
SHOW TABLES;

