SELECT
    UPPER(customer_name) AS customer_name,
    LOWER(product) AS product,
    MONTHNAME(STR_TO_DATE(order_date, '%Y-%m-%d')) AS month_name,
    amount - (amount * discount / 100) AS final_amount
FROM store_sales;

-- Q38
SELECT
    month_name,
    SUM(final_amount) AS total_final_revenue
FROM (
    SELECT
        MONTHNAME(STR_TO_DATE(order_date, '%Y-%m-%d')) AS month_name,
        amount - (amount * discount / 100) AS final_amount
    FROM online_sales

    UNION ALL

    SELECT
        MONTHNAME(STR_TO_DATE(order_date, '%Y-%m-%d')) AS month_name,
        amount - (amount * discount / 100) AS final_amount
    FROM store_sales
) AS all_sales
GROUP BY month_name;

-- Q39
SELECT
    city,
    SUM(final_amount) AS total_revenue
FROM (
    SELECT
        city,
        amount - (amount * discount / 100) AS final_amount
    FROM online_sales

    UNION ALL

    SELECT
        city,
        amount - (amount * discount / 100) AS final_amount
    FROM store_sales
) AS all_sales
GROUP BY city;

-- q40
SELECT
    product,
    SUM(final_amount) AS final_revenue
FROM (
    SELECT
        product,
        amount - (amount * discount / 100) AS final_amount
    FROM online_sales

    UNION ALL

    SELECT
        product,
        amount - (amount * discount / 100) AS final_amount
    FROM store_sales
) AS all_sales
GROUP BY product
ORDER BY final_revenue DESC
LIMIT 3;

-- Q41
SELECT
    UPPER(customer_name) AS customer_name,
    city,
    product,
    category,
    MONTHNAME(STR_TO_DATE(order_date, '%Y-%m-%d')) AS month_name,
    quantity,
    amount AS original_amount,
    discount,
    amount - (amount * discount / 100) AS final_amount,
    CASE
        WHEN amount - (amount * discount / 100) >= 15000
            THEN 'High Value'
        ELSE 'Regular'
    END AS sale_classification
FROM online_sales

UNION ALL

SELECT
    UPPER(customer_name) AS customer_name,
    city,
    product,
    category,
    MONTHNAME(STR_TO_DATE(order_date, '%Y-%m-%d')) AS month_name,
    quantity,
    amount AS original_amount,
    discount,
    amount - (amount * discount / 100) AS final_amount,
    CASE
        WHEN amount - (amount * discount / 100) >= 15000
            THEN 'High Value'
        ELSE 'Regular'
    END AS sale_classification
FROM store_sales

ORDER BY final_amount DESC;
