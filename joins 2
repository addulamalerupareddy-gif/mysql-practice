use techmart_db;

select avg(price) from products;
select * from products;
select round(avg(price)) from products;

select * from products
where price > ( select round(avg(price)) from products);

-- find the product(s) having the highest price
select * from products
where price=(select max(price) from products);

-- display all orders placed by customers from hyderabad

select * from 
customers c join
orders o on c.customer_id=o.customer_id
where c.city='hyderabad';

select * from customers;
select * from orders
where customer_id in (select customer_id from customers
where city='hyderabad');

select * from orders
where customer_id in (select customer_id from customers
where city='hyderabad' or 'bengaluru');

select customer_name from customers
where customer_id not in (select customer_id from orders);

select customer_name from customers
where customer_id  in (select customer_id from orders);

select * from products;
select category_id from categories where category_name='accessories';

select price from products
 where category_id=(select category_id from categories where category_name='accessories');


select * from products
where price < any (select price from products
 where category_id=(select category_id from categories where category_name='smart watches'));
 
select * from products;
select avg(price) from products where category_id=1;

select * from products p1
where price > (select avg(price) from products p2
where p2.category_id=p1.category_id);

select * from products p join categories c on p.category_id=c.category_id;

select * from products
where category_id=1;

select c.category_name,p.product_name,p.price from products p join categories c on p.category_id=c.category_id
where price=(select max(price) from products p2
where p2.category_id=p.category_id);

use shopsphere_db;

select * from store_sales;
select customer_name,city,product,amount-(amount * discount /100) as final_amount
from store_sales
union all
select customer_name,city,product,amount-(amount * discount /100) as final_amount
from online_sales;

select city, sum(final_amount) from (
select customer_name,city,product,amount-(amount * discount /100) as final_amount
from store_sales
union all
select customer_name,city,product,amount-(amount * discount /100) as final_amount
from online_sales) as combined_data
group by city;
